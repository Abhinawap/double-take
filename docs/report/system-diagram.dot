// System diagram for the report. Render: dot -Tpng -Gdpi=200 system-diagram.dot -o system-diagram.png
digraph G {
  rankdir=LR; newrank=true; nodesep=0.3; ranksep=0.45; compound=true;
  node [shape=box, style="rounded,filled", fillcolor=white, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  student [label="Student\n(revising)", shape=ellipse, fillcolor="#e8eef7"];
  input   [label="Question box\n+ scope line"];

  subgraph cluster_core { label="Stability check  ·  stability.py check()  ·  JSON parsed strictly, one retry"; fontname="Helvetica-Bold"; fontsize=10; style=rounded; color="#777777";
    detect [label="AI: Detect leading?\nwrite neutral version", fillcolor="#e3f1e3"];
    ans1   [label="AI: Answer\nthe question", fillcolor="#e3f1e3"];
    ans2   [label="AI: Answer the\nneutral version", fillcolor="#e3f1e3"];
    judge  [label="AI: Judge\nmain claims +\nSAME / DIFFERENT", fillcolor="#e3f1e3"];
  }

  subgraph cluster_out { label="Shown to the student  ·  app.py"; fontname="Helvetica-Bold"; fontsize=10; style=rounded; color="#777777";
    progress [label="Progress line\n\"Comparing answers…\""];
    answer   [label="Answer\n(no badge)"];
    warning  [label="Instability warning\nboth questions, main claims,\nanswers side by side", fillcolor="#fff1cc"];
    failline [label="\"I couldn't compare…\"\nabove the answer"];
  }

  llm    [label="gpt-oss-120b · Nebius API\nT=1.0, top_p=1.0", shape=cylinder, fillcolor="#e3f1e3"];
  notes  [label="Notes / slides", shape=folder, fillcolor="#e8eef7"];

  student -> input [label="types"];
  input -> detect; input -> ans1 [label="in parallel"];
  detect -> ans2 [label="leading"];
  ans1 -> judge [label="held"]; ans2 -> judge;
  detect -> answer [label="not leading"];
  judge -> answer [label="SAME"];
  judge -> warning [label="DIFFERENT"];
  {detect judge} -> failline [label="unparseable\ntwice", color="#999999"];
  detect -> progress [label="stage", color="#999999", arrowhead=open, constraint=false];
  warning -> notes [label="student checks"];
  judge -> llm [ltail=cluster_core, style=dotted, arrowhead=none, label="all AI calls"];

  // simulated
  replays [label="Replay mode\nreplays/*.json saved by record.py\n(no API key needed)", shape=note, style="dashed,filled", fillcolor="#f0f0f0"];
  replays -> warning [style=dashed, lhead=cluster_out, label="same display"];

  // planned
  subgraph cluster_plan { label="Planned"; fontname="Helvetica"; fontsize=10; style="rounded,dotted"; color="#888888"; fontcolor="#666666";
    node [style="rounded,dotted", color="#888888", fontcolor="#555555"];
    v3   [label="v3 rewrite rule\n\"why\" → ask the fact"];
    ask2 [label="Ask-twice trigger"];
    push [label="Pushback trigger\n\"Are you sure?\""];
  }
  v3 -> detect [style=dotted, color="#888888"];
  {ask2 push} -> ans2 [style=dotted, color="#888888"];

  {rank=same; student; replays}
  {rank=same; v3; ask2; push}

  label="Solid = implemented   ·   dashed = simulated (saved runs)   ·   dotted = planned   ·   green = AI (LLM call)"; labelloc=b; fontname="Helvetica"; fontsize=10;
}
